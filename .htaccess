Options -Indexes
RewriteEngine On

# Apache no pasa la cabecera Authorization a PHP por defecto.
RewriteCond %{HTTP:Authorization} .
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# No reescribir ficheros ni directorios reales (css, js, imágenes).
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php [QSA,L]

# Nunca servir configuración ni secretos.
<FilesMatch "^\.env">
    Require all denied
</FilesMatch>
<FilesMatch "\.(sqlite|lock|log|md)$">
    Require all denied
</FilesMatch>

# El bundle de Claude Design no es público.
<FilesMatch "\.zip$">
    Require all denied
</FilesMatch>

# Carpetas internas. OJO: el patrón está anclado al nombre de la carpeta del
# proyecto; si se renombra coupon-gift hay que actualizar esta línea.
RedirectMatch 403 ^/coupon-gift/(app|cli|config|data|database|logs|routes|vendor)(/|$)
