; Copia este fichero a .env y rellena los valores.
; El .env real está en .gitignore y nunca se versiona.

; ── Aplicación ────────────────────────────────────────────────────────────────
; URL pública completa, sin barra final. Es la que se codifica en los QR y la
; que se envía en los correos, así que tiene que ser accesible desde el móvil.
; En local: http://localhost:81/coupon-gift
APP_URL=https://tu-dominio.example/coupon-gift

; Ruta de la app dentro del dominio. En local: /coupon-gift. Si la app cuelga
; de la raíz del dominio (https://cuponera.example/), pon una barra sola: /
BASE_URL=/coupon-gift

; 1 = mostrar errores en pantalla (solo para diagnosticar). Con 0 el error real
; queda en logs/app.log y el usuario ve una página genérica.
APP_DEBUG=0

; ── Base de datos ─────────────────────────────────────────────────────────────
; php-apache y mariadb comparten la red Docker dev_net, así que el hostname
; resuelve. No pongas aquí la IP LAN del host: cambia y deja la app con 500.
DB_HOST=mariadb
DB_PORT=3306
DB_NAME=coupon_gift
DB_USER=
DB_PASS=
DB_CHARSET=utf8mb4

; ── Correo (PHPMailer sobre SMTP) ─────────────────────────────────────────────
; La imagen php:8.5-apache no trae MTA, así que mail() no funciona: hace falta
; un SMTP real. Con Gmail/Outlook usa una contraseña de aplicación, no la tuya.
; En hosting compartido (IONOS) suele estar bloqueada la salida a SMTP ajenos:
; usa el del propio hosting (smtp.ionos.mx / smtp.ionos.es / smtp.ionos.com).
;
; Puerto y cifrado van EMPAREJADOS:  587 + tls (STARTTLS)  o  465 + ssl.
; Si pones 465, se usa ssl aunque escribas tls.
MAIL_HOST=smtp.office365.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USER=
MAIL_PASS=
MAIL_FROM=
MAIL_FROM_NAME=Cuponeras

; ── Telegram ──────────────────────────────────────────────────────────────────
; Los avisos y los botones van a través del backend compartido del bot (proyecto
; telegram-bot), que es quien tiene el token y el webhook. Alta en el bot:
;   php cli/project.php add coupons https://<dominio>/telegram/bot
; URL del bot, sin barra final. Docker local: http://localhost/telegram-bot
BOT_BACKEND_URL=
; Clave que mostró «cli/project.php add» (una sola vez). Si se pierde, en el bot:
; php cli/project.php rotate-key coupons
BOT_PROJECT_KEY=
; Opcional: nombre del proyecto en el bot si no es «coupons».
; BOT_PROJECT=coupons

; ── Worker ────────────────────────────────────────────────────────────────────
; Secreto para disparar cli/worker.php por HTTP (cron). Vacío = solo CLI.
; Genéralo con: php -r "echo bin2hex(random_bytes(16));"
CRON_SECRET=
